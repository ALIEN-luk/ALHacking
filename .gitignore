# alhack.sh clones third-party repositories into ./Tools at runtime.
# The repository's own tooling lives in ./tools - the negations below keep it
# visible even on case-insensitive filesystems (macOS/Windows).  They must stay
# above the file-type rules: there, the later (more specific) rules win again.
/Tools/
!/tools/
!/tools/**

# Build artefacts - never commit the compiled copies of the scanner or tests.
__pycache__/
*.pyc
*.pyo

# Reports and local captures: masked, but they still describe where secrets
# lived (see SECRETS_POLICY.md, rules 4 and 5).
SECRETS_REPORT.md
secrets.json
secrets.sarif
scan.txt
LeakCheck.txt
*.report.txt

# Local material that must never be pushed.
/secrets/
.env
.env.*
!sample.env
*.pem
*.key
*.p12
*.pfx
*_rsa
id_rsa*
credentials.json
